# Copy to .env and fill in. .env is gitignored; never commit real values.
# REQUIRED = the app will not run correctly without it.

# --- Database (REQUIRED) -----------------------------------------------------
# Any Postgres reachable over the Neon serverless driver (Neon is what we run on).
# Then apply the schema: pnpm db:migrate
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Auth (REQUIRED) ---------------------------------------------------------
# Signs sessions and tokens. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL of this deployment. Used for auth callbacks, OAuth for MCP
# clients, and the links inside emails. No trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# --- LLM: Consult (chat with an agent), reviews and the drift check -------------
# Providers: groq, openai, anthropic, google, xai, cohere. Bring your own key: whoever runs this
# instance sets it here, and every workspace on the instance uses it (your provider bills you).
# AI is optional. With no key at all, everything else works; reviews are skipped and Consult says why.
# Only Groq has been verified end to end. Others stay switched off until you verify them with a real
# key (see AI_UNVERIFIED_PROVIDERS). Without any key, reviews are skipped and Consult says why.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=

# Encrypts the secrets people save on the Connections page (Slack webhook URLs, GitHub tokens, MCP
# server tokens) with AES-256-GCM. 32 random bytes, base64:   openssl rand -base64 32
# Without it, adding a connection fails with a clear message; secrets are never stored unencrypted.
# Losing or changing it makes stored connection secrets unreadable (people re-enter them).
SECRETS_ENCRYPTION_KEY=

# Comma-separated providers to switch on before they are verified, e.g. AI_UNVERIFIED_PROVIDERS=openai,anthropic
# Verify one first: VERIFY_OPENAI_KEY=sk-... pnpm vitest run src/lib/ai/provider-verify.live.test.ts
AI_UNVERIFIED_PROVIDERS=

# Set to 1 only on Captap's own hosted service: caps each workspace's AI spend on the instance key
# (free plan $0.50/month) and shows the hosted /privacy and /terms pages. Leave unset when self-hosting:
# your instance, your key, no cap.
CAPTAP_CLOUD=

# --- Email (needed for invite / approval / decision emails) --------------------
# Resend (https://resend.com). The sender domain must be verified in Resend.
# Without a key nothing is emailed: invites fall back to copy-the-link and the
# app logs "email not sent".
RESEND_API_KEY=
EMAIL_FROM=Captap <notifications@your-verified-domain.com>

# --- Image uploads in the editor (optional) ------------------------------------
# From the Cloudinary console -> API keys. Without them the editor says
# "Image uploads aren't set up yet". Restart the dev server after adding them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- GitHub (optional) ---------------------------------------------------------
# A token lets Captap verify commits and CI on private repos and open PRs.
# Public repos are read without one, at GitHub's low anonymous rate limit.
GITHUB_TOKEN=

# --- Connections: one-click Slack/GitHub (optional, spec 024) ------------------
# Without these, Connections still works — users paste a Slack webhook URL / GitHub
# token manually. With them, a "Connect Slack" / "Connect GitHub" button does it
# via OAuth instead. You have to create these yourself; Captap can't generate them:
#   Slack:  api.slack.com/apps -> Create New App -> OAuth & Permissions -> add
#           redirect URL "<your domain>/api/connections/slack/callback",
#           request scope "incoming-webhook" -> Basic Information for the IDs.
#   GitHub: github.com/settings/developers -> New OAuth App -> Authorization
#           callback URL "<your domain>/api/connections/github/callback".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Hosted service contact (only with CAPTAP_CLOUD=1) ---------------------------
# Shown on /privacy and /terms as the address for questions and account deletion requests.
SUPPORT_EMAIL=

# --- Email verification (hosted deployments) ----------------------------------
# Set to 1 to require new accounts to confirm their email before signing in. Needs RESEND_API_KEY
# (the server refuses to start without it). Leave unset when self-hosting without email: nobody
# could ever verify. Existing unverified accounts get a fresh link when they next try to sign in.
REQUIRE_EMAIL_VERIFICATION=

# --- Docker trial only (set by docker-compose.yml, never needed on Neon) ------
# Points the Neon serverless driver at the local WebSocket proxy in front of plain Postgres,
# e.g. "wsproxy:80". Leave unset everywhere else.
NEON_WS_PROXY=

# --- Local MCP bridge script (optional, scripts/mcp-bridge.mjs) ----------------
# Only if you use the stdio bridge instead of connecting your agent to /api/mcp directly.
PROJECT_OS_URL=http://localhost:3000
PROJECT_OS_TOKEN=
